# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shop.bluuhq.com

# ── Cloudflare R2 (product/shop images) ───────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bluushop-uploads
CLOUDFLARE_R2_PUBLIC_URL=https://shop-uploads.bluuhq.com
