# ── Supabase (own project — not shared with crm/) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://shop.bluuhq.com

# ── Admin (/admin) ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of emails that can sign in and reach /admin.
# No roles table — see lib/admin.ts for why an env allowlist is the right
# size here.
ADMIN_EMAILS=you@bluuhq.com

# ── Billing reminder emails (Resend) ─────────────────────────────────────────
# Sent on failed renewal charges (Stripe invoice.payment_failed, Paystack
# invoice.payment_failed) — see lib/payment-reminders.ts.
RESEND_API_KEY=re_...
RESEND_FROM_NAME=BluuShop
RESEND_FROM_EMAIL=hello@bluuhq.com

# ── Cloudflare R2 (product/shop images) ───────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bluushop-uploads
CLOUDFLARE_R2_PUBLIC_URL=https://shop-uploads.bluuhq.com
